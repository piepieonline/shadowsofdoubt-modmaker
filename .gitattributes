# Both source repos were entirely LF at import time; keep it that way.
* text=auto eol=lf

*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.svg  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

*.png binary
*.ico binary

# Generated reference data from ShadowsOfDoubtMods/DocumentationGenerator.
# Multi-MB JSON; diffing it is never useful. refs/authored/ is deliberately absent --
# those files are hand-maintained and their diffs are worth reading.
refs/generated/*.json -diff linguist-generated
refs/assets/**/*.json -diff linguist-generated

# Floor blueprints and building presets, copied out of the game. Not the generator's
# yet -- see GENERATOR.md section 5 -- but game data all the same, and a floor is one
# 60 KB line, so a diff of one is no more readable than a diff of the others.
refs/floors/**/*.json -diff linguist-generated

# Derived from a dump of the game by flows/building/tools/buildFurnitureChain.js.
# Written as one line and never edited by hand, so its diffs say nothing the script's
# diff does not say better. See refs/README.md.
refs/derived/*.json -diff linguist-generated
